---
import { getAppUrl } from "src/lib/utils";
import { PUBLIC_EMAIL } from "src/lib/constants";

const title = "Hashdown - Markdown-first forms";

const features = [
  {
    title: "Markdown First",
    description:
      "Write questions in Markdown and keep forms in version control.",
  },
  {
    title: "Shareable Links",
    description: "Publish a hosted form and share a single URL.",
  },
  {
    title: "Embeds & Exports",
    description: "Embed in docs or a site, and export responses when needed.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/hlogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-content">
        <a class="navbar-logo" href="/">
          <img src="/hashdown.png" alt="Hashdown logo" height="32" />
          <span hidden class="">Hashdown</span>
        </a>
        <div class="navbar-links">
          <a href="#features">Features</a>
          <a href={getAppUrl()}>Editor</a>
          <!-- <a href="#pricing">Pricing</a> -->
          <!-- <a href="/login" class="nav-login">Log in</a>
          <a href="/signup" class="nav-cta">Sign up</a> -->
        </div>
      </div>
    </nav>

    <main class="container">
      <section class="hero">
        <div class="hero-content">
          <div class="hero-eyebrow">Markdown-first form builder</div>
          <h1 class="hero-title">
            Forms you can version<br />
            <span class="text-gradient">and publish</span>.
          </h1>
          <p class="hero-sub">
            Draft a form in plain text, publish a hosted link, and edit it
            alongside your code.
          </p>
          <div class="hero-actions">
            <a class="cta-btn primary" href={getAppUrl()}>Open editor</a>
            <a class="cta-btn secondary" href="#features">View features</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="code-window">
            <div class="code-header">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
              <div class="window-title">form.md</div>
            </div>
            <div class="code-content">
              <div class="code-line">
                <span class="line-num">1</span><span
                  ><span class="token-hash">#</span>
                  <span class="token-text">Product Feedback</span></span
                >
              </div>
              <div class="code-line">
                <span class="line-num">2</span><span></span>
              </div>
              <div class="code-line">
                <span class="line-num">3</span><span
                  ><span class="token-text">Please rate your experience:</span
                  ></span
                >
              </div>
              <div class="code-line">
                <span class="line-num">4</span><span
                  ><span class="token-field">- [ ]</span>
                  <span class="token-text">Excellent</span></span
                >
              </div>
              <div class="code-line">
                <span class="line-num">5</span><span
                  ><span class="token-field">- [ ]</span>
                  <span class="token-text">Good</span></span
                >
              </div>
              <div class="code-line">
                <span class="line-num">6</span><span
                  ><span class="token-field">- [ ]</span>
                  <span class="token-text">Needs Improvement</span></span
                >
              </div>
              <div class="code-line">
                <span class="line-num">7</span><span></span>
              </div>
              <div class="code-line">
                <span class="line-num">8</span><span
                  ><span class="token-text">Any comments?</span></span
                >
              </div>
              <div class="code-line">
                <span class="line-num">9</span><span
                  ><span class="token-field">___</span></span
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features">
        <h2 class="section-title">Why Hashdown?</h2>
        <div class="features-grid">
          {
            features.map((feature, index) => (
              <div class="feature-card">
                <div class="feature-tag">0{index + 1}</div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="how-it-works">
        <h2 class="section-title">How it works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Write</h3>
              <p>Define your questions using standard Markdown syntax.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Share</h3>
              <p>Get a unique URL or embed code for your website.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Collect</h3>
              <p>Review responses or export them.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2 class="section-title">Treat Forms Like Code</h2>
        <p>
          Keep forms alongside your code. Review changes, reuse templates, and
          ship updates without a complex UI.
        </p>
        <div style="text-align: center; margin-top: 2rem">
          <a class="cta-btn primary" href={getAppUrl()}>Open editor</a>
        </div>
      </section>

      <!-- Pricing section disabled: no payment flow yet -->
      <!--
      <section id="pricing">
        <h2 class="section-title">Pricing</h2>
        <div class="pricing-page">
          <div class="tiers-container">
            {
              tiers.map((tier) => (
                <div class="tier">
                  <h2 class="tier-name">{tier.name}</h2>
                  <p class="price">
                    {tier.price}
                    <span class="per-month">/month</span>
                  </p>
                  <ul class="features-list-pricing">
                    {tier.features.map((feature) => (
                      <li class="feature">{feature}</li>
                    ))}
                  </ul>
                  <button class="plan-button">Select plan</button>
                </div>
              ))
            }
          </div>
        </div>
      </section>
      -->

      <section class="questions">
        <h2 class="section-title">Questions?</h2>
        <p>
          Want to confirm a feature or roadmap item? Email
          <a href="mailto:{PUBLIC_EMAIL}">{PUBLIC_EMAIL}</a>.
        </p>
      </section>

      <footer>
        <div class="footer-content">
          <p>© 2026 Hashdown. All rights reserved.</p>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg-dark: #f8f7f4;
    --bg-elevated: #ffffff;
    --text-primary: #131313;
    --text-secondary: #5b5b5b;
    --accent: #f35815;
    --accent-hover: #ff6a2b;
    --accent-ink: #ffffff;
    --border-color: rgba(12, 12, 12, 0.12);
    --card-bg: #ffffff;
    --grid-color: rgba(12, 12, 12, 0.04);
  }

  html,
  body {
    margin: 0;
    padding: 0;
    font-family: "Inter", system-ui, sans-serif;
    background-color: var(--bg-dark);
    background-image:
      radial-gradient(
        circle at 20% 10%,
        rgba(243, 88, 21, 0.16),
        transparent 52%
      ),
      radial-gradient(circle at 80% 0%, rgba(12, 12, 12, 0.04), transparent 45%);
    color: var(--text-primary);
    min-height: 100vh;
    scroll-behavior: smooth;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(12, 12, 12, 0.03) 0px,
        rgba(12, 12, 12, 0.03) 1px,
        transparent 1px,
        transparent 4px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.02) 0px,
        rgba(12, 12, 12, 0.02) 1px,
        transparent 1px,
        transparent 4px
      );
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
    opacity: 0.22;
  }

  /* Navbar */
  .navbar {
    width: 100%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    position: sticky;
    top: 0;
    z-index: 100;
    height: 64px;
  }
  .navbar-content {
    width: 100%;
    max-width: 1160px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
  }
  .navbar-logo {
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-primary);
    text-decoration: none;
    gap: 0.75rem;
  }
  .navbar-logo img {
    border-radius: 6px;
  }
  .navbar-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .navbar-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    font-size: 0.85rem;
  }
  .navbar-links a:hover {
    color: var(--text-primary);
  }
  .nav-login {
    margin-left: 1rem;
  }
  .nav-cta {
    background: var(--accent);
    color: #000 !important;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-weight: 600;
    transition:
      transform 0.2s,
      background-color 0.2s !important;
  }
  .nav-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.5rem;
    overflow-x: hidden;
    position: relative;
    z-index: 1;
  }

  /* Hero Section */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 7.5rem 0 5.5rem;
    gap: 2.5rem;
  }
  .hero-content {
    max-width: 760px;
  }
  .hero-eyebrow {
    font-family: "IBM Plex Mono", "Menlo", "Monaco", "Courier New", monospace;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.66rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .text-gradient {
    background: linear-gradient(120deg, #131313, #f35815 65%, #ff6a2b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.6;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    border-radius: 999px;
    padding: 0.7rem 1.35rem;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .cta-btn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 10px 30px rgba(243, 88, 21, 0.22);
  }
  .cta-btn.primary:hover {
    background: var(--accent-hover);
  }
  .cta-btn.secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid rgba(12, 12, 12, 0.2);
  }
  .cta-btn.secondary:hover {
    border-color: var(--text-secondary);
    background: rgba(12, 12, 12, 0.03);
  }

  .hero-visual {
    width: 100%;
    max-width: 800px;
    perspective: 1000px;
    position: relative;
  }
  .hero-visual::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(
      circle,
      rgba(243, 88, 21, 0.2) 0%,
      transparent 70%
    );
    z-index: -1;
    filter: blur(50px);
    pointer-events: none;
  }

  .code-window {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.25rem;
    box-shadow:
      0 0 0 1px rgba(12, 12, 12, 0.1),
      0 28px 50px -26px rgba(12, 12, 12, 0.25);
    border: 1px solid rgba(12, 12, 12, 0.08);
    font-family: "IBM Plex Mono", "Menlo", "Monaco", "Courier New", monospace;
    overflow: hidden;
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(12, 12, 12, 0.08);
  }
  .window-title {
    margin-left: auto;
    margin-right: auto;
    color: var(--text-secondary);
    font-size: 0.75rem;
    transform: translateX(-24px); /* Adjust for dots */
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red {
    background: #ef4444;
  }
  .dot-yellow {
    background: #f59e0b;
  }
  .dot-green {
    background: #22c55e;
  }

  .code-content {
    color: #1f1f1f;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .code-line {
    display: flex;
    gap: 1.5rem;
  }
  .line-num {
    color: #9b9b9b;
    user-select: none;
    width: 20px;
    text-align: right;
  }
  .token-hash {
    color: #f35815;
  }
  .token-text {
    color: #1a1a1a;
  }
  .token-field {
    color: #4b8f63;
  }

  section {
    margin-bottom: 7rem;
  }
  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.3rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 3rem;
    text-align: center;
    letter-spacing: -0.02em;
  }

  /* Features */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .feature-card {
    background: var(--card-bg);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
  }
  .feature-card:hover {
    border-color: rgba(247, 241, 232, 0.3);
  }
  .feature-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 26px;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-family: "IBM Plex Mono", "Menlo", "Monaco", "Courier New", monospace;
    color: var(--accent-ink);
    background: rgba(243, 88, 21, 0.6);
    margin-bottom: 1.5rem;
  }
  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .feature-card p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* How It Works */
  .how-it-works {
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 5.5rem 0;
    background: linear-gradient(
      to bottom,
      rgba(243, 88, 21, 0.05),
      transparent
    );
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    align-items: start;
  }
  .step-number {
    width: 36px;
    height: 36px;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 50%;
    font-size: 0.95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .step-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Content Section */
  .content-section {
    text-align: center;
    border: 1px solid var(--border-color);
    padding: 3.5rem 2rem;
    border-radius: 20px;
    background: radial-gradient(
      circle at center,
      rgba(243, 88, 21, 0.06),
      transparent 70%
    );
  }
  .content-section p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 700px;
    margin: 0 auto;
  }

  footer {
    border-top: 1px solid var(--border-color);
    padding: 2.5rem 0;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .questions {
    text-align: center;
    margin: 0 auto 5rem auto;
    max-width: 700px;
  }
  .questions p {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 1rem;
  }
  .questions a {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(243, 88, 21, 0.5);
  }
  .questions a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .navbar-links {
      display: none; /* Simplified mobile menu */
    }
    .step-arrow {
      display: none;
    }
  }
</style>
